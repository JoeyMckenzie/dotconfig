#!/usr/bin/env bash
# usage: write-site <hostname> <app_port> <vite_port>
# Writes a Caddyfile fragment for one site to ~/.config/devenv/sites/.
# Caller chooses the hostname (apex like braggadoc.test, or subdomain
# like feature-foo-bar.braggadoc.test). Caller is responsible for calling
# reload-caddy afterwards (so a worktree can write multiple fragments
# and reload once).
set -euo pipefail

hostname="${1:?usage: write-site <hostname> <app_port> <vite_port>}"
app_port="${2:?missing app_port}"
vite_port="${3:?missing vite_port}"

out="$HOME/.config/devenv/sites/${hostname}.caddy"
cat > "$out" <<CADDY
${hostname}:8443 {
    tls internal

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy 127.0.0.1:${vite_port}
    }

    @vite path /@vite/* /@id/* /@fs/* /@react-refresh /resources/* /node_modules/* /__laravel_vite_plugin__/*
    handle @vite {
        reverse_proxy 127.0.0.1:${vite_port}
    }

    handle {
        reverse_proxy 127.0.0.1:${app_port}
    }
}
CADDY
