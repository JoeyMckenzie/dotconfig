#!/usr/bin/env bash
# usage: write-site <slug> <short_name> <app_port> <vite_port>
# Writes a Caddyfile fragment for one worktree to ~/.config/devenv/sites/.
# Caller is responsible for calling reload-caddy afterwards (so a worktree
# can write multiple fragments and reload once).
set -euo pipefail

slug="${1:?usage: write-site <slug> <short_name> <app_port> <vite_port>}"
short="${2:?missing short_name}"
app_port="${3:?missing app_port}"
vite_port="${4:?missing vite_port}"

out="$HOME/.config/devenv/sites/${slug}-${short}.caddy"
cat > "$out" <<CADDY
${slug}-${short}.test:8443 {
    tls internal

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy 127.0.0.1:${vite_port}
    }

    @vite path /@vite/* /@id/* /@fs/* /@react-refresh /resources/* /node_modules/* /__laravel_vite_plugin__/*
    handle @vite {
        reverse_proxy 127.0.0.1:${vite_port}
    }

    handle {
        reverse_proxy 127.0.0.1:${app_port}
    }
}
CADDY
