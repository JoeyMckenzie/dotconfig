#!/usr/bin/env bash
# usage: register-project <slug> [--db pgsql|mysql|sqlite|both]
# idempotent. default --db=pgsql preserves prior behavior.
#
# pgsql:  creates role <slug>/<slug> with CREATEDB and template DB <slug>_main.
# mysql:  creates user <slug>/<slug> with privileges on `<slug>_%` databases.
#         no template DB — per-worktree DBs are created on shell entry.
# sqlite: nothing to provision; the project's enterShell creates the DB file.
# both:   pgsql + mysql.
set -euo pipefail

slug=""
db="pgsql"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --db) db="${2:?--db needs a value}"; shift 2 ;;
        --db=*) db="${1#--db=}"; shift ;;
        -h|--help) echo "usage: register-project <slug> [--db pgsql|mysql|sqlite|both]"; exit 0 ;;
        -*) echo "register-project: unknown flag '$1'" >&2; exit 1 ;;
        *) slug="$1"; shift ;;
    esac
done

if [[ -z "$slug" ]]; then
    echo "usage: register-project <slug> [--db pgsql|mysql|sqlite|both]" >&2
    exit 1
fi

# Validate slug — only lowercase letters, digits, underscores. Avoids SQL injection
# and stops weird DB names from creeping in.
if ! [[ "$slug" =~ ^[a-z][a-z0-9_]*$ ]]; then
    echo "register-project: slug '$slug' must match ^[a-z][a-z0-9_]*$" >&2
    exit 1
fi

if ! [[ "$db" =~ ^(pgsql|mysql|sqlite|both)$ ]]; then
    echo "register-project: --db must be pgsql, mysql, sqlite, or both (got '$db')" >&2
    exit 1
fi

register_pgsql() {
    psql -h 127.0.0.1 -U "$USER" -d postgres <<SQL
DO \$\$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '${slug}') THEN
    CREATE ROLE "${slug}" WITH LOGIN PASSWORD '${slug}' CREATEDB;
  END IF;
END \$\$;
SELECT 'CREATE DATABASE "${slug}_main" OWNER "${slug}"'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${slug}_main')\gexec
SQL
}

register_mysql() {
    # Grant on `<slug>\_%` so the user can CREATE/DROP its own DBs.
    # \_ escapes the underscore so it's literal (not a single-char wildcard).
    mysql -u root <<SQL
CREATE USER IF NOT EXISTS '${slug}'@'127.0.0.1' IDENTIFIED BY '${slug}';
CREATE USER IF NOT EXISTS '${slug}'@'localhost' IDENTIFIED BY '${slug}';
GRANT ALL PRIVILEGES ON \`${slug}\\_%\`.* TO '${slug}'@'127.0.0.1';
GRANT ALL PRIVILEGES ON \`${slug}\\_%\`.* TO '${slug}'@'localhost';
FLUSH PRIVILEGES;
SQL
}

[[ "$db" == pgsql || "$db" == both ]] && register_pgsql
[[ "$db" == mysql || "$db" == both ]] && register_mysql
[[ "$db" == sqlite ]] && echo "register-project: sqlite needs no provisioning — skipping"
