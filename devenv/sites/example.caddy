# example.caddy — reference for the per-site fragment shape.
# Real fragments are generated by `write-site <slug> <short> <app_port> <vite_port>`
# and gitignored. Everything below is commented so caddy treats this as a no-op.
#
# example-main.test:8443 {
#     tls internal
#
#     @websocket {
#         header Connection *Upgrade*
#         header Upgrade websocket
#     }
#     handle @websocket {
#         reverse_proxy 127.0.0.1:5173
#     }
#
#     @vite path /@vite/* /@id/* /@fs/* /@react-refresh /resources/* /node_modules/* /__laravel_vite_plugin__/*
#     handle @vite {
#         reverse_proxy 127.0.0.1:5173
#     }
#
#     handle {
#         reverse_proxy 127.0.0.1:8000
#     }
# }
