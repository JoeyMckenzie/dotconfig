# example.caddy — reference for the per-site fragment shape.
# Real fragments are generated by `write-site <hostname> <app_port> <vite_port>`
# and gitignored. Examples:
#   write-site example.test 8000 5173                # apex (main worktree)
#   write-site feature-x.example.test 8001 5174      # subdomain (worktree)
# Everything below is commented so caddy treats this as a no-op.
#
# example.test:8443 {
#     tls internal
#
#     @websocket {
#         header Connection *Upgrade*
#         header Upgrade websocket
#     }
#     handle @websocket {
#         reverse_proxy 127.0.0.1:5173
#     }
#
#     @vite path /@vite/* /@id/* /@fs/* /@react-refresh /resources/* /node_modules/* /__laravel_vite_plugin__/*
#     handle @vite {
#         reverse_proxy 127.0.0.1:5173
#     }
#
#     handle {
#         reverse_proxy 127.0.0.1:8000
#     }
# }
