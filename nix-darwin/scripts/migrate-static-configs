#!/usr/bin/env bash
# Run after the Home Manager declarations for these files have been removed.
set -euo pipefail

config_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
source_root="$config_root/nix-darwin/home/config"

enable_tracking() {
  local gitignore="$config_root/.gitignore"

  if grep -Fqx '!ghostty/config' "$gitignore"; then
    return
  fi

  cat >>"$gitignore" <<'EOF'

# Additional user-authored tool configuration. Keep credentials and state ignored.
!gh/
gh/*
!gh/config.yml
!ghostty/
ghostty/*
!ghostty/config
!lazygit/
lazygit/*
!lazygit/config.yml
!starship.toml
EOF
}

release_managed_link() {
  local path="$1"

  if [[ ! -L "$path" ]]; then
    return
  fi

  local target
  target=$(readlink "$path")
  case "$target" in
  /nix/store/*-home-manager-files/*) rm "$path" ;;
  *)
    printf 'Refusing to replace non-Home-Manager symlink: %s -> %s\n' \
      "$path" "$target" >&2
    exit 1
    ;;
  esac
}

migrate() {
  local source="$source_root/$1"
  local destination="$config_root/$2"

  if [[ ! -f "$source" ]]; then
    if [[ -f "$destination" && ! -L "$destination" ]]; then
      printf 'Already migrated: %s\n' "$2"
      return
    fi

    printf 'Missing migration source: %s\n' "$source" >&2
    exit 1
  fi

  if [[ -L "$destination" ]]; then
    local target
    target=$(readlink "$destination")
    case "$target" in
    /nix/store/*-home-manager-files/*) rm "$destination" ;;
    *)
      printf 'Refusing to replace non-Home-Manager symlink: %s -> %s\n' \
        "$destination" "$target" >&2
      exit 1
      ;;
    esac
  elif [[ -e "$destination" ]]; then
    printf 'Refusing to replace existing file: %s\n' "$destination" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$destination")"
  mv "$source" "$destination"
  printf 'Migrated: %s\n' "$2"
}

release_managed_link "$HOME/Library/Application Support/com.mitchellh.ghostty/config"
migrate ghostty.conf ghostty/config
migrate gh-config.yml gh/config.yml
migrate lazygit.yml lazygit/config.yml
migrate starship.toml starship.toml
migrate btop.conf btop/btop.conf
migrate btop-tokyonight-night.theme btop/themes/tokyonight_night.theme
migrate graphite-aliases graphite/aliases
migrate herdr.toml herdr/config.toml
migrate opencode.json opencode/opencode.json
migrate superfile-config.toml superfile/config.toml
migrate superfile-hotkeys.toml superfile/hotkeys.toml
migrate worktrunk.toml worktrunk/config.toml
enable_tracking
