// Givebutter worktree layout — spawned by `wt new` via the .config/wt.toml
// post-start hook. Three panes, all starting in the new worktree's dir:
//   - Left (60%):       nvim opened on the repo
//   - Top-right (20%):  claude code session
//   - Bottom-right:     `devenv up` (boots php-fpm + horizon + dashboard + …)
layout {
    pane split_direction="vertical" {
        pane size="60%" command="nvim" {
            args "."
        }
        pane size="40%" split_direction="horizontal" {
            pane command="claude"
            pane command="devenv" {
                args "up"
            }
        }
    }
}
