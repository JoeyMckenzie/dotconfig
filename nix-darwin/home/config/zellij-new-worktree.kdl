layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="50%" command="nvim" {
                args "."
                name "neovim"
            }
            pane size="50%" split_direction="horizontal" {
                pane command="claude" {
                  name "claude"
                }
                pane name="devenv"
            }
        }
        pane size=2 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}
