{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "disable_provider_auto_update": true
  },
  "providers": {
    "bedrock": { "disable": true }
  },
  "models": {
    "large": { "provider": "zai", "model": "glm-4.6" },
    "small": { "provider": "zai", "model": "glm-4.5-air" }
  },
  "lsp": {
    "go": { "command": "gopls" },
    "typescript": { "command": "typescript-language-server", "args": ["--stdio"] },
    "nix": { "command": "nil" },
    "php": { "command": "intelephense", "args": ["--stdio"] },
    "lua": { "command": "lua-language-server" }
  },
  "permissions": {
    "allowed_tools": ["view", "ls", "grep"]
  }
}
